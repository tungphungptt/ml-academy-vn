DATABASE_URL="file:./dev.db"
# Generate a random value with at least 32 characters; never commit real secrets.
SESSION_SECRET=""
# Optional: set BOTH only to create a new admin during an explicit seed.
# Existing users/admins are never promoted or overwritten by seed.
# ADMIN_EMAIL=""
# ADMIN_PASSWORD=""
# Docker uses /data/lesson-overrides on its persistent volume.
# LESSON_CONTENT_DIR="/absolute/path/to/lesson-overrides"
# Đặt "true" khi chạy sau HTTPS; "false" khi dùng HTTP (localhost/LAN). Mặc định: true ở production.
# COOKIE_SECURE="false"
# PORT=3000
# Compose only: keep both paths inside the mounted volume. Back up/migrate
# existing data before changing these; changing a URL does not move data.
# DOCKER_DATABASE_URL="file:/data/app.db"
# DOCKER_LESSON_CONTENT_DIR="/data/lesson-overrides"
