{
 "name": "ml-academy-vn",
 "private": true,
 "scripts": {
  "dev": "next dev",
  "build": "prisma generate && next build",
  "start": "next start",
  "db:seed": "tsx prisma/seed.ts",
  "setup": "npm ci && prisma generate && node scripts/prepare-db.mjs",
  "typecheck": "next typegen && tsc --noEmit",
  "test": "tsx --test tests/*.test.ts tests/*.test.tsx",
  "local": "node scripts/local.mjs",
  "prod": "node scripts/local.mjs --prod",
  "verify": "npm run typecheck && npm test",
  "check:links": "node scripts/check_links.mjs",
  "e2e": "playwright test",
  "db:initialize": "node scripts/prepare-db.mjs",
  "db:migrate": "prisma migrate deploy",
  "db:status": "prisma migrate status",
  "content:import": "tsx scripts/import-lessons.ts",
  "db:dev": "prisma migrate dev",
  "deploy:local": "node scripts/deploy-local.mjs"
 },
 "dependencies": {
  "@prisma/client": "5.20.0",
  "bcryptjs": "2.4.3",
  "jose": "5.9.3",
  "katex": "0.19.1",
  "next": "16.4.3",
  "react": "19.3.1",
  "react-dom": "19.3.1",
  "react-markdown": "9.0.1",
  "rehype-katex": "7.0.1",
  "remark-math": "6.0.0",
  "zod": "4.6.7"
 },
 "devDependencies": {
  "@playwright/test": "1.64.1",
  "@types/bcryptjs": "2.4.6",
  "@types/node": "24.19.2",
  "@types/react": "19.3.0",
  "@types/react-dom": "19.3.0",
  "prisma": "5.20.0",
  "tsx": "4.23.15",
  "typescript": "5.6.2"
 },
 "version": "1.2.0",
 "engines": {
  "node": ">=24.0.0 <25"
 },
 "overrides": {
  "katex": "$katex"
 }
}
